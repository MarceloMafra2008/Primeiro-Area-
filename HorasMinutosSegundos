#include <stdio.h>
int main()
{
    int tempo, horas, minutos, resto, segundos;

    printf("digite um valor em segundos:");
    scanf("%d", &tempo);
    
    horas = tempo / 3600;
    
    resto = tempo%3600;
    
    minutos =  resto / 60;

    segundos = resto%60;

    printf("%02d:%02d:%02d", horas, minutos, segundos);

}
