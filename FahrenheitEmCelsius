//pergunte um valor em graus Fahrenheit e imprime o  correspondente em graus Celsius 
// formula para conversao: C=(f-32.0) * (5.0/9.0).
#include <stdio.h>
int main()
{
    float faren, celsius;

    printf("digite graus em fahrenheit :");
    scanf("%f", &faren);

    celsius = (faren-32.0) * (5.0/9.0);

    printf("conversao de fahrenheit para celsius = %f", celsius);

}
