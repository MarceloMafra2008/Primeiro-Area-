#include <stdio.h>
int main()
{
    float km, litros, consumo_medio, total;

    printf("distancia total percorrida:");
    scanf("%f", &km);

    printf("\n");

    printf("gasto total de combustivel:");
    scanf("%f", &litros);

    printf("\n");

    consumo_medio = km / litros;
    printf("O consumo medio:%.2f", consumo_medio);

    printf("\n");

    total= consumo_medio * 6,20;
    printf("\nCusto total da viagem:%.2f", total);

    return 0;
}
